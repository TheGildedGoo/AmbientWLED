<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.ambientwled"
       name="AmbientWLED Repo"
       version="1.0.0"
       provider-name="TheGildedGoo">
  <extension point="xbmc.addon.repository" name="AmbientWLED Repo">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/TheGildedGoo/AmbientWLED/main/repo/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/TheGildedGoo/AmbientWLED/main/repo/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/TheGildedGoo/AmbientWLED/main/repo/zips</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Personal CoreELEC repository for AmbientWLED</summary>
    <description lang="en_GB">Install and update AmbientWLED from GitHub.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/TheGildedGoo/AmbientWLED</source>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
<addon id="script.module.ambientwled"
       name="AmbientWLED Library"
       version="0.2.0"
       provider-name="Dylan King">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.python.module" library="lib"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Shared library for AmbientWLED</summary>
    <description lang="en_GB">WLED JSON, DDP, geometry mapper, colour pipe, and Hyperion client used by AmbientWLED. No xbmc imports in the library itself.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/TheGildedGoo/AmbientWLED</source>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
<addon id="script.service.ambientwled"
       name="AmbientWLED"
       version="0.2.0"
       provider-name="Dylan King">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="script.module.ambientwled" version="0.2.0"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.python.script" library="run.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Bias lighting from Kodi to WLED</summary>
    <description lang="en_GB">AmbientWLED samples the TV picture on CoreELEC and drives a GLEDOPTO GL-C-017WL-D (or any WLED) over DDP. It does not touch HDMI, eARC, or audio. Enable it from the setup wizard.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/TheGildedGoo/AmbientWLED</source>
    <news>Picture-to-WLED: DDP RGBW, edge mapper, colour pipe, RenderCapture with Hyperion fallback.</news>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
<addon id="plugin.program.ambientwled"
       name="AmbientWLED Settings"
       version="0.2.0"
       provider-name="Dylan King">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="script.module.ambientwled" version="0.2.0"/>
    <import addon="script.service.ambientwled" version="0.2.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">AmbientWLED setup wizard</summary>
    <description lang="en_GB">Remote-only setup for AmbientWLED: WLED address, strip, geometry, picture, and behaviour. Opens the service settings when setup is already done.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/TheGildedGoo/AmbientWLED</source>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
</addons>
